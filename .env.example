# Required. Generate locally with: openssl rand -base64 32
ENCRYPTION_KEY=

# Key rotation (docs/encryption-keys.md). A JSON object of key id to base64 key,
# plus the id new writes use. ENCRYPTION_KEY, if set, joins it as id `legacy`.
ENCRYPTION_KEYS=
ENCRYPTION_ACTIVE_KEY_ID=

# Host-side connection to the compose database. The app container overrides this
# with host `postgres`; anything you run outside Docker — migrations, dev:server —
# needs the published localhost port instead.
DATABASE_URL=postgres://bifrost:bifrost@localhost:5432/bifrost
# Postgres connections per process. Multiply by replicas to size max_connections.
DATABASE_POOL_MAX=20

# Same story as DATABASE_URL. Leaving this empty is valid but degrades locks,
# rate limits, and concurrency leases to in-process state.
REDIS_URL=redis://localhost:6379

PUBLIC_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Required only for the built-in chat, which runs on Claude through the Anthropic API.
# ANTHROPIC_EFFORT is one of low, medium, high, xhigh or max.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=high

# Optional. Lets administrators set an automatic rule per provider: Jev classifies
# each new tool against it and sets its default. Without a key, new tools stay
# blocked until an administrator reviews them. Changed tools always wait for one.
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13

# Comma-separated exact Google email addresses allowed to administer tools
# discovered from providers' official MCP servers. Empty leaves every newly
# discovered or changed tool blocked.
ADMIN_EMAILS=

# Who may sign in. The two lists OR together: whole domains for the team, exact
# addresses for anyone outside them. Leaving BOTH empty lets any verified Google
# account in, and the sign-in screen will say so instead of claiming otherwise.
ALLOWED_EMAIL_DOMAINS=
ALLOWED_EMAILS=

# Upstream MCP clients stay connected per user and provider and are reused
# across calls. Closed after this many idle seconds, or least recently used
# first beyond the maximum.
UPSTREAM_CLIENT_IDLE_SECONDS=300
UPSTREAM_CLIENT_MAX=200

# Development-only UUID for header auth during local verification. Never set in production.
BIFROST_DEV_USER_ID=
