# Required. Generate locally with: openssl rand -base64 32
ENCRYPTION_KEY=

# Host-side connection to the compose database. The app container overrides this
# with host `postgres`; anything you run outside Docker — migrations, dev:server —
# needs the published localhost port instead.
DATABASE_URL=postgres://bifrost:bifrost@localhost:5432/bifrost

# Same story as DATABASE_URL. Leaving this empty is valid but degrades locks,
# rate limits, and concurrency leases to in-process state.
REDIS_URL=redis://localhost:6379

PUBLIC_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Required only for the built-in chat. BASE_URL defaults to OpenAI's official
# API. Compatible overrides must support Responses and Tool Search.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=medium

# Comma-separated exact Google email addresses allowed to administer tools
# discovered from providers' official MCP servers. Empty leaves every newly
# discovered or changed tool blocked.
ADMIN_EMAILS=

# Who may sign in. The two lists OR together: whole domains for the team, exact
# addresses for anyone outside them. Leaving BOTH empty lets any verified Google
# account in, and the sign-in screen will say so instead of claiming otherwise.
ALLOWED_EMAIL_DOMAINS=
ALLOWED_EMAILS=

# Development-only UUID for header auth during local verification. Never set in production.
BIFROST_DEV_USER_ID=
