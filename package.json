{
  "name": "bifrost",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.5.2",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.build.json",
    "build:client": "vite build",
    "dev": "npm run dev:infra && npm run migrate && concurrently --names server,client --prefix-colors cyan,magenta --kill-others npm:dev:server npm:dev:client",
    "dev:infra": "docker compose up -d --wait postgres redis && docker compose stop app",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:client": "vite",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "migrate": "tsx --env-file-if-exists=.env src/database/migrate.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "jose": "6.1.0",
    "lucide-react": "^1.31.0",
    "next-themes": "^0.4.6",
    "pg": "8.16.3",
    "pino": "9.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "redis": "5.8.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.3.0",
    "@types/pg": "8.15.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "3.2.7",
    "concurrently": "^10.0.5",
    "drizzle-kit": "0.31.10",
    "eslint": "9.34.0",
    "tailwindcss": "^4.3.3",
    "tsx": "4.20.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vite": "^7.3.6",
    "vitest": "3.2.7"
  }
}
